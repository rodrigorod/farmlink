# Server Environment
PORT=8088
ENV=development

# JWT Authentication (generate a secure 32+ byte secret for production)
JWT_SECRET=farmlink-dev-secret-key-fs25

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farmlink?sslmode=disable

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=farmlink-mods
S3_REGION=us-east-1
